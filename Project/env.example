# 环境变量示例：复制成 .env 或直接 export 后使用（真实的 .env 不要提交到仓库）
#
# MySQL（本机 WSL 里这套跑在 3307，因为 3306 被 Windows 侧的 MySQL 占用了）
JOTANG_MYSQL_HOST=127.0.0.1
JOTANG_MYSQL_PORT=3307
JOTANG_MYSQL_USER=jotang
JOTANG_MYSQL_PASSWORD=在这里填你的密码
JOTANG_MYSQL_DB=jotangnote

# Redis
JOTANG_REDIS_HOST=127.0.0.1
JOTANG_REDIS_PORT=6379
JOTANG_REDIS_DB=0

# RabbitMQ（本地默认 guest/guest）
JOTANG_RABBITMQ_HOST=127.0.0.1
JOTANG_RABBITMQ_PORT=5672
JOTANG_RABBITMQ_USER=guest
JOTANG_RABBITMQ_PASSWORD=guest
JOTANG_NOTE_QUEUE=note.ops

# 缓存策略（秒）
JOTANG_NOTE_CACHE_TTL=300
JOTANG_EMPTY_CACHE_TTL=60
JOTANG_LOCK_TTL=5
